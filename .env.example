GEMINI_API_KEY=your_gemini_api_key # Required
GEMINI_API_SECRET=your_gemini_api_secret # Optional
GEMINI_API_MODEL=your_gemini_api_model # Optional
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/ # Optional

# Admin Secret — dodaj u URL: ?unlock=TVOJ_PASSWORD za neograničen pristup
ADMIN_SECRET=your_admin_secret # Required

#Tavily
TAVILY_API_KEY=your_tavily_api_key # Optional

# PostHog analytics (EU region) — production only; set on Render, not locally
POSTHOG_PROJECT_TOKEN=phc_your_project_api_key # Optional (alias: POSTHOG_API_KEY)
POSTHOG_HOST=https://eu.i.posthog.com # Optional — default is EU cloud